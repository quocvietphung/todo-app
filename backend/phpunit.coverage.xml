<?xml version="1.0" encoding="UTF-8"?>
<phpunit
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
        bootstrap="vendor/autoload.php"
        colors="true"
        failOnWarning="false"
        failOnRisky="false"
        convertDeprecationsToExceptions="false"
        cacheResult="false"
>
    <testsuites>
        <testsuite name="Todo App Test Suite">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <coverage>
        <include>
            <directory suffix=".php">core</directory>
            <directory suffix=".php">repository</directory>
            <directory suffix=".php">service</directory>
            <directory suffix=".php">controller</directory>
        </include>

        <report>
            <text outputFile="php://stdout" showUncoveredFiles="false"/>
            <html outputDirectory="coverage-report" lowUpperBound="50" highLowerBound="80"/>
        </report>
    </coverage>

    <php>
        <ini name="error_reporting" value="-1"/>
        <env name="TZ" value="Europe/Berlin"/>
        <env name="XDEBUG_MODE" value="coverage"/>
    </php>
</phpunit>