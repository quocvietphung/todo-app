{
  "name": "vietphung/todo-app",
  "description": "A clean OOP Todo App with PHP + SQLite backend, following PSR-4 autoloading.",
  "type": "project",
  "license": "MIT",

  "autoload": {
    "psr-4": {
      "Core\\": "core/",
      "Model\\": "model/",
      "Repository\\": "repository/",
      "Service\\": "service/",
      "Controller\\": "controller/",
      "Migrations\\": "migrations/"
    }
  },

  "autoload-dev": {
    "psr-4": {
      "Test\\": "tests/"
    }
  },

  "require": {
    "php": ">=8.0"
  },

  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },

  "scripts": {
    "serve": "php -S localhost:8000 -t public",
    "dump": "composer dump-autoload",
    "test": "vendor/bin/phpunit --testdox",
    "migrate": "php migrate.php",
    "migrate:rollback": "php migrate.php down",
    "migrate:fresh": "php migrate.php down && php migrate.php"
  },

  "config": {
    "process-timeout": 0
  },

  "minimum-stability": "stable",
  "prefer-stable": true
}